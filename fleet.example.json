{
  "title": "MYLAB",
  "nodes": [
    {
      "id": "spark1",
      "name": "Spark One",
      "role": "DGX SPARK",
      "shortLabel": "SPARK",
      "probe": "vllm-ssh",
      "baseURL": "http://192.168.1.50:8000",
      "hostname": "spark-abcd",
      "address": "192.168.1.50",
      "sshHost": "spark1",
      "gatewayBackend": "spark1",
      "pingAlias": "spark-main",
      "container": "my-vllm-container",
      "modelProfiles": {
        "coding": {
          "activateCommand": "/opt/honeycomb/serve-coding-model.sh",
          "verifyCommand": "curl -fsS http://127.0.0.1:8000/v1/models >/dev/null",
          "rollbackCommand": "/opt/honeycomb/restore-previous-model.sh",
          "autoRollback": true,
          "timeoutSec": 1200
        }
      },
      "notes": "Online = SSH reachable. Models = whatever vLLM serves."
    },
    {
      "id": "hub",
      "name": "My Mac",
      "role": "CONTROL PLANE",
      "shortLabel": "HUB",
      "probe": "lmstudio-hub",
      "baseURL": "http://127.0.0.1:1234",
      "gatewayBackend": "lms",
      "pingAlias": "local-lms",
      "hub": true,
      "notes": "The machine Honeycomb runs on."
    }
  ],
  "links": [
    {
      "from": "spark1",
      "to": "hub",
      "checkHost": "spark1",
      "checkCommand": "test -r /sys/class/net/eth0/operstate && test \"$(cat /sys/class/net/eth0/operstate)\" = up"
    }
  ]
}
